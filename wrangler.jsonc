{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mel",
  "compatibility_date": "2026-05-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    // Serve directory routes without a trailing slash and 308-redirect the
    // slash variant, matching the non-slash canonical + sitemap. Kills the
    // GSC "duplicate without trailing slash" reports.
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
