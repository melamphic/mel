# /mel — Salvia marketing & signup site (Vite)
#
# All Vite env vars must be prefixed with VITE_ to be exposed to the browser.
# For local dev, copy this to `.env` and run `npm run dev`.

# Base URL of the Sal backend (handoff + pricing APIs).
# Dev: the local API server started by `cd ../sal && make dev`.
# Prod: e.g. https://api.salvia.nz
VITE_SAL_API_BASE=http://localhost:8080

# Address shown on the pricing page for "Talk to sales" links.
VITE_SUPPORT_EMAIL=sales@salvia.nz

# Base URL of the Salvia web app (header "Sign In" destination).
# Dev: e.g. http://localhost:5173 if running salvia/apps in web mode.
# Prod: e.g. https://app.salvia.nz
VITE_APP_URL=https://app.salvia.nz

# PostHog (analytics — country, device, funnel events).
# Get the project key from posthog.com → Project Settings → Project API key.
# Salvia project is on EU Cloud — host is https://eu.i.posthog.com.
# (US Cloud would be https://us.i.posthog.com if you migrate.)
# Leave VITE_POSTHOG_KEY empty in dev to disable tracking locally.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
